# Copy this file to .env.production and change every secret before deploying.

SECRET_KEY_FILE=/run/secrets/finanpy_django_secret_key
ALLOWED_HOSTS=finanpy.com.br,www.finanpy.com.br
CSRF_TRUSTED_ORIGINS=https://finanpy.com.br,https://www.finanpy.com.br
SESSION_COOKIE_DOMAIN=.finanpy.com.br
CSRF_COOKIE_DOMAIN=.finanpy.com.br

POSTGRES_DB=finanpy
POSTGRES_USER=finanpy
POSTGRES_PASSWORD_FILE=/run/secrets/finanpy_postgres_password

# Keep true when the app is behind HTTPS.
# For a temporary IP-only smoke test without TLS, set this to false.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

HTTP_PORT=80
LOG_LEVEL=INFO

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD_FILE=/run/secrets/finanpy_smtp_password
DEFAULT_FROM_EMAIL=FinanPy <noreply@example.com>
